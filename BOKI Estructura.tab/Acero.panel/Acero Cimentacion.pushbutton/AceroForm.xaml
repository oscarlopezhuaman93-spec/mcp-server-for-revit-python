<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acero - Cimentaci&#243;n"
        Height="880" Width="1560" MinWidth="1200" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" PreviewKeyDown="window_key">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" x:Name="button_run" Content="Generar acero..." Width="220" Height="40"
                    FontWeight="Bold" Click="run_click"
                    ToolTip="Guarda recubrimientos y acero en el tipo y genera las barras en los elementos seleccionados."/>
            <Button DockPanel.Dock="Right" Content="Abrir archivo..." Width="130" Height="40" Margin="0,0,8,0" Click="file_open_click"
                    ToolTip="Carga los recubrimientos guardados en un archivo."/>
            <Button DockPanel.Dock="Right" Content="Guardar en archivo..." Width="150" Height="40" Margin="0,0,8,0" Click="file_save_click"
                    ToolTip="Guarda los recubrimientos por cara en un archivo."/>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: elements + configuration -->
            <ScrollViewer Grid.Column="0" Margin="0,0,10,0" VerticalScrollBarVisibility="Auto">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="1. Selecciona la cimentaci&#243;n (zapata, cimiento corrido, losa de cimentaci&#243;n)."/>
                <Button DockPanel.Dock="Top" x:Name="button_pick" Content="SELECCIONAR CIMENTACI&#211;N" Height="34"
                        FontWeight="Bold" Click="pick_click"/>
                <TextBlock DockPanel.Dock="Top" x:Name="txt_picked" Foreground="Gray" HorizontalAlignment="Center"
                           Margin="0,4,0,6" Text="No hay elementos seleccionados."/>
                <ListBox DockPanel.Dock="Top" x:Name="list_elements" MaxHeight="160" SelectionChanged="element_selected"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                <Expander DockPanel.Dock="Top" Header="2. Recubrimientos por cara" Margin="0,8,0,0" IsExpanded="True">
                    <DockPanel Margin="6,4,6,4">
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,6"
                                   Text="Cada cara tiene su color y n&#250;mero en la vista 3D y en los alzados. Haz clic en una casilla para resaltar su cara."/>
                        <ScrollViewer DockPanel.Dock="Top" MaxHeight="190" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="panel_covers"/>
                        </ScrollViewer>
                    </DockPanel>
                </Expander>
                <Expander DockPanel.Dock="Top" Header="3. Configuraci&#243;n de acero" Margin="0,8,0,0" IsExpanded="True">
                    <StackPanel Margin="6,4,6,4">
                        <CheckBox x:Name="chk_bot" Content="Malla inferior (gancho hacia arriba)" FontWeight="Bold" Margin="0,4,0,2" IsChecked="True" Click="steel_changed"/>
                        <StackPanel Orientation="Horizontal" Margin="16,1,0,1" IsEnabled="{Binding IsChecked, ElementName=chk_bot}">
                            <TextBlock Text="X &#216;" Width="26" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cbo_bot_dx" Width="58" SelectionChanged="steel_changed"/>
                            <ComboBox x:Name="cbo_bot_mx" Width="82" Margin="3,0,0,0" SelectionChanged="steel_changed"
                                      ToolTip="Espaciado: barras cada @ m. Cantidad: n barras repartidas. Ambos: n barras cada @ m, centradas."/>
                            <TextBox x:Name="txt_bot_nx" Width="30" Margin="3,0,0,0" TextChanged="steel_changed" ToolTip="Cantidad de barras"/>
                            <TextBlock Text=" @" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_bot_sx" Width="40" TextChanged="steel_changed"/>
                            <TextBlock Text=" m" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="42,0,0,2" IsEnabled="{Binding IsChecked, ElementName=chk_bot}">
                            <TextBlock Text="Tipo " VerticalAlignment="Center" Foreground="Gray"/>
                            <ComboBox x:Name="cbo_bot_tx" Width="232" SelectionChanged="type_changed"
                                      ToolTip="Tipo de barra de armadura de Revit (todos los del proyecto). Autom&#225;tico: el que corresponde al di&#225;metro."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,1,0,1" IsEnabled="{Binding IsChecked, ElementName=chk_bot}">
                            <TextBlock Text="Y &#216;" Width="26" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cbo_bot_dy" Width="58" SelectionChanged="steel_changed"/>
                            <ComboBox x:Name="cbo_bot_my" Width="82" Margin="3,0,0,0" SelectionChanged="steel_changed"
                                      ToolTip="Espaciado: barras cada @ m. Cantidad: n barras repartidas. Ambos: n barras cada @ m, centradas."/>
                            <TextBox x:Name="txt_bot_ny" Width="30" Margin="3,0,0,0" TextChanged="steel_changed" ToolTip="Cantidad de barras"/>
                            <TextBlock Text=" @" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_bot_sy" Width="40" TextChanged="steel_changed"/>
                            <TextBlock Text=" m" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="42,0,0,2" IsEnabled="{Binding IsChecked, ElementName=chk_bot}">
                            <TextBlock Text="Tipo " VerticalAlignment="Center" Foreground="Gray"/>
                            <ComboBox x:Name="cbo_bot_ty" Width="232" SelectionChanged="type_changed"
                                      ToolTip="Tipo de barra de armadura de Revit (todos los del proyecto). Autom&#225;tico: el que corresponde al di&#225;metro."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,1,0,1" IsEnabled="{Binding IsChecked, ElementName=chk_bot}">
                            <TextBlock Text="Tramos (m):  T1 " VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_bot_ha" Width="40" TextChanged="steel_changed"
                                     ToolTip="T1: gancho al inicio de la barra (m). 0 = sin gancho."/>
                            <TextBlock Text="  T2 = largo del elemento  T3 " VerticalAlignment="Center" Foreground="Gray"/>
                            <TextBox x:Name="txt_bot_hb" Width="40" TextChanged="steel_changed"
                                     ToolTip="T3: gancho al final de la barra (m). 0 = sin gancho."/>
                        </StackPanel>
                        <CheckBox x:Name="chk_top" Content="Malla superior (gancho hacia abajo)" FontWeight="Bold" Margin="0,4,0,2" IsChecked="False" Click="steel_changed"/>
                        <StackPanel Orientation="Horizontal" Margin="16,1,0,1" IsEnabled="{Binding IsChecked, ElementName=chk_top}">
                            <TextBlock Text="X &#216;" Width="26" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cbo_top_dx" Width="58" SelectionChanged="steel_changed"/>
                            <ComboBox x:Name="cbo_top_mx" Width="82" Margin="3,0,0,0" SelectionChanged="steel_changed"
                                      ToolTip="Espaciado: barras cada @ m. Cantidad: n barras repartidas. Ambos: n barras cada @ m, centradas."/>
                            <TextBox x:Name="txt_top_nx" Width="30" Margin="3,0,0,0" TextChanged="steel_changed" ToolTip="Cantidad de barras"/>
                            <TextBlock Text=" @" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_top_sx" Width="40" TextChanged="steel_changed"/>
                            <TextBlock Text=" m" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="42,0,0,2" IsEnabled="{Binding IsChecked, ElementName=chk_top}">
                            <TextBlock Text="Tipo " VerticalAlignment="Center" Foreground="Gray"/>
                            <ComboBox x:Name="cbo_top_tx" Width="232" SelectionChanged="type_changed"
                                      ToolTip="Tipo de barra de armadura de Revit (todos los del proyecto). Autom&#225;tico: el que corresponde al di&#225;metro."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,1,0,1" IsEnabled="{Binding IsChecked, ElementName=chk_top}">
                            <TextBlock Text="Y &#216;" Width="26" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cbo_top_dy" Width="58" SelectionChanged="steel_changed"/>
                            <ComboBox x:Name="cbo_top_my" Width="82" Margin="3,0,0,0" SelectionChanged="steel_changed"
                                      ToolTip="Espaciado: barras cada @ m. Cantidad: n barras repartidas. Ambos: n barras cada @ m, centradas."/>
                            <TextBox x:Name="txt_top_ny" Width="30" Margin="3,0,0,0" TextChanged="steel_changed" ToolTip="Cantidad de barras"/>
                            <TextBlock Text=" @" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_top_sy" Width="40" TextChanged="steel_changed"/>
                            <TextBlock Text=" m" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="42,0,0,2" IsEnabled="{Binding IsChecked, ElementName=chk_top}">
                            <TextBlock Text="Tipo " VerticalAlignment="Center" Foreground="Gray"/>
                            <ComboBox x:Name="cbo_top_ty" Width="232" SelectionChanged="type_changed"
                                      ToolTip="Tipo de barra de armadura de Revit (todos los del proyecto). Autom&#225;tico: el que corresponde al di&#225;metro."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,1,0,1" IsEnabled="{Binding IsChecked, ElementName=chk_top}">
                            <TextBlock Text="Tramos (m):  T1 " VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_top_ha" Width="40" TextChanged="steel_changed"
                                     ToolTip="T1: gancho al inicio de la barra (m). 0 = sin gancho."/>
                            <TextBlock Text="  T2 = largo del elemento  T3 " VerticalAlignment="Center" Foreground="Gray"/>
                            <TextBox x:Name="txt_top_hb" Width="40" TextChanged="steel_changed"
                                     ToolTip="T3: gancho al final de la barra (m). 0 = sin gancho."/>
                        </StackPanel>
                        <CheckBox x:Name="chk_sketch" Content="Boceto (barras dibujadas a mano)" FontWeight="Bold" Margin="0,8,0,2"
                                  IsChecked="True" Click="steel_changed"/>
                        <StackPanel Orientation="Horizontal" Margin="16,1,0,1" IsEnabled="{Binding IsChecked, ElementName=chk_sketch}">
                            <ToggleButton x:Name="btn_sketch" Width="30" Height="26" Click="sketch_toggle"
                                          ToolTip="Boceto por l&#237;nea: clic en cada punto en un alzado. Los puntos se pegan a las barras (puntos), al centro de cada lado y a las esquinas del recubrimiento. Clic en el primer punto cierra un estribo (envuelve las barras, con ganchos hacia adentro); clic derecho termina. Esc cancela.">
                                <Canvas Width="16" Height="16">
                                    <Rectangle Width="16" Height="16" Stroke="#FF5B8BD0" StrokeThickness="1"/>
                                    <Line X1="3" Y1="13" X2="13" Y2="3" Stroke="#FF2E5FA8" StrokeThickness="2"/>
                                    <Rectangle Canvas.Left="1" Canvas.Top="11" Width="4" Height="4" Fill="#FF2E5FA8"/>
                                    <Rectangle Canvas.Left="11" Canvas.Top="1" Width="4" Height="4" Fill="#FF2E5FA8"/>
                                </Canvas>
                            </ToggleButton>
                            <ToggleButton x:Name="btn_rect" Width="30" Height="26" Margin="3,0,0,0" Click="rect_toggle"
                                          ToolTip="Mediante dos puntos: estribo rectangular, clic en dos esquinas opuestas (se ajustan a las barras, al centro de cada lado y al recubrimiento).">
                                <Canvas Width="18" Height="18">
                                    <Rectangle Canvas.Left="2" Canvas.Top="2" Width="14" Height="14" Stroke="#FF5A5A5A" StrokeThickness="1.5"/>
                                    <Rectangle Canvas.Left="0" Canvas.Top="0" Width="5" Height="5" Fill="#FF2F7FE0"/>
                                    <Rectangle Canvas.Left="13" Canvas.Top="13" Width="5" Height="5" Fill="#FF2F7FE0"/>
                                </Canvas>
                            </ToggleButton>
                            <TextBlock Text=" &#216;" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cbo_sketch_d" Width="58" Margin="2,0,0,0" SelectionChanged="sketch_props_changed"/>
                            <ComboBox x:Name="cbo_sketch_m" Width="82" Margin="3,0,0,0" SelectionChanged="sketch_props_changed"/>
                            <TextBox x:Name="txt_sketch_n" Width="30" Margin="3,0,0,0" Text="5" TextChanged="sketch_props_changed" ToolTip="Cantidad de barras"/>
                            <TextBlock Text=" @" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_sketch_s" Width="40" Text="0.20" TextChanged="sketch_props_changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="48,0,0,2" IsEnabled="{Binding IsChecked, ElementName=chk_sketch}">
                            <TextBlock Text="Tipo " VerticalAlignment="Center" Foreground="Gray"/>
                            <ComboBox x:Name="cbo_sketch_t" Width="226" SelectionChanged="type_changed"/>
                        </StackPanel>
                        <StackPanel Margin="16,2,0,1" IsEnabled="{Binding IsChecked, ElementName=chk_sketch}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Borrar" Width="56" Click="sketch_delete"/>
                                <TextBlock x:Name="txt_sketch_count" Text="0 barras dibujadas" Foreground="Gray" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ListBox x:Name="list_sketch" MaxHeight="80" Margin="0,2,0,2" SelectionChanged="sketch_selected"/>
                            <TextBlock Text="Longitudes de tramos (m) de la barra elegida:" Foreground="Gray" FontSize="11"/>
                            <WrapPanel x:Name="panel_segments"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>
                <Expander DockPanel.Dock="Top" Header="4. Empalme de barras" Margin="0,8,0,0">
                    <StackPanel Margin="6,4,6,4">
                        <CheckBox x:Name="chk_splice" Click="splice_changed"
                                  Content="Empalmar las barras m&#225;s largas que la longitud m&#225;xima"
                                  ToolTip="Las barras de los di&#225;metros marcados que superan la longitud m&#225;xima se cortan en piezas que se traslapan con su longitud de empalme. Es la misma configuraci&#243;n de Acero Columna y Acero Viga."/>
                        <StackPanel Orientation="Horizontal" Margin="18,4,0,4" IsEnabled="{Binding IsChecked, ElementName=chk_splice}">
                            <TextBlock Text="Longitud maxima de barra: " VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_splice_max" Width="45" TextChanged="splice_changed"/>
                            <TextBlock Text=" m" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Empalme por diametro: marca los que se empalman (cm; sugerido E.060 clase B):" TextWrapping="Wrap" Margin="0,2,0,2"/>
                        <WrapPanel x:Name="panel_laps" IsEnabled="{Binding IsChecked, ElementName=chk_splice}"/>
                    </StackPanel>
                </Expander>
            </DockPanel>
            </ScrollViewer>

            <!-- Center: faces (colors and numbers) and steel, each a 3D view -->
            <Grid Grid.Column="1" Margin="0,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton x:Name="rb_top_plan" GroupName="topview" IsChecked="True" Checked="top_view_changed"
                                     FontWeight="Bold" Content="PLANTA (zonas y cortes)" Margin="0,0,14,0"/>
                        <RadioButton x:Name="rb_top_3d" GroupName="topview" Checked="top_view_changed"
                                     FontWeight="Bold" Content="VISTA 3D - CARAS"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="txt_title" Foreground="Gray" FontSize="11" Margin="0,0,0,3"
                               TextTrimming="CharacterEllipsis"/>
                    <WrapPanel DockPanel.Dock="Top" x:Name="panel_plan_tools" Margin="0,0,0,4">
                        <TextBlock Text="Malla " VerticalAlignment="Center"/>
                        <ComboBox x:Name="cbo_plan_layer" Width="80" SelectionChanged="plan_tools_changed"
                                  ToolTip="La malla que se ve y se edita en la planta."/>
                        <TextBlock Text="  Barras " VerticalAlignment="Center"/>
                        <ComboBox x:Name="cbo_plan_dir" Width="62" SelectionChanged="plan_tools_changed"
                                  ToolTip="X: las barras que corren en X (se reparten a lo largo de Y). Y: las que corren en Y."/>
                        <Button Content="Zonas autom&#225;ticas" Margin="6,0,0,0" Padding="6,1" Click="zones_auto"
                                ToolTip="Divide el reparto donde cambia la forma de la planta (entrantes, quiebres). Cada zona toma la distribuci&#243;n de la configuraci&#243;n; una cantidad se convierte en su espaciado, para que todas tengan la misma densidad."/>
                        <ToggleButton x:Name="btn_zone_split" Content="&#9986; Dividir zona" Margin="4,0,0,0" Padding="6,1"
                                      ToolTip="Clic en la planta donde quieres cortar la zona: las dos partes conservan su distribuci&#243;n."/>
                        <Button Content="Quitar zonas" Margin="4,0,0,0" Padding="6,1" Click="zones_clear"
                                ToolTip="Vuelve a una sola distribuci&#243;n en toda la cimentaci&#243;n."/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="txt_plan_hint" Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="Arrastra las l&#237;neas rojas A y B para mover los cortes de los alzados. Clic en el texto de una zona para cambiar su cantidad (15), espaciado (@0.20) o ambos (15@0.20). Arrastra un l&#237;mite verde para moverlo; clic derecho sobre &#233;l lo quita. Rueda: zoom, bot&#243;n central: mover, doble clic central: ajustar."/>
                    <Grid>
                        <Border x:Name="border_plan" BorderBrush="#FFBBBBBB" BorderThickness="1">
                            <Canvas x:Name="canvas_plan" Background="White" ClipToBounds="True" SizeChanged="views_resized"
                                    MouseLeftButtonDown="plan_left" MouseRightButtonDown="plan_right" MouseMove="plan_move"
                                    MouseWheel="plan_wheel" MouseDown="plan_down" MouseUp="plan_up"/>
                        </Border>
                        <Border x:Name="border_3d" BorderBrush="#FFBBBBBB" BorderThickness="1" Background="White" Visibility="Collapsed">
                            <Viewport3D x:Name="view3d" ClipToBounds="True"
                                        MouseWheel="view3d_wheel" MouseDown="view3d_mouse_down" MouseUp="view3d_mouse_up"
                                        MouseMove="view3d_mouse_move"/>
                        </Border>
                    </Grid>
                </DockPanel>
                <DockPanel Grid.Row="1">
                    <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,4" Text="VISTA 3D - ACERO (con los elementos conectados)"/>
                    <Border BorderBrush="#FFBBBBBB" BorderThickness="1" Background="White">
                        <Viewport3D x:Name="view3d_steel" ClipToBounds="True"
                                    MouseWheel="steel3d_wheel" MouseDown="steel3d_mouse_down" MouseUp="steel3d_mouse_up"
                                    MouseMove="steel3d_mouse_move"/>
                    </Border>
                </DockPanel>
            </Grid>

            <!-- Right: two elevations -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Top" x:Name="txt_front_title" FontWeight="Bold" Margin="0,0,0,4" Text="ALZADO FRONTAL - corte A (mirando hacia +Y)"/>
                    <Border BorderBrush="#FFBBBBBB" BorderThickness="1">
                        <Canvas x:Name="canvas_front" Background="White" ClipToBounds="True" SizeChanged="views_resized"
                                MouseLeftButtonDown="front_left" MouseRightButtonDown="front_right" MouseMove="front_move"
                                MouseWheel="front_wheel" MouseDown="front_down" MouseUp="front_up"/>
                    </Border>
                </DockPanel>
                <DockPanel Grid.Row="1">
                    <TextBlock DockPanel.Dock="Top" x:Name="txt_side_title" FontWeight="Bold" Margin="0,0,0,4" Text="ALZADO LATERAL - corte B (mirando hacia -X)"/>
                    <Border BorderBrush="#FFBBBBBB" BorderThickness="1">
                        <Canvas x:Name="canvas_side" Background="White" ClipToBounds="True" SizeChanged="views_resized"
                                MouseLeftButtonDown="side_left" MouseRightButtonDown="side_right" MouseMove="side_move"
                                MouseWheel="side_wheel" MouseDown="side_down" MouseUp="side_up"/>
                    </Border>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
