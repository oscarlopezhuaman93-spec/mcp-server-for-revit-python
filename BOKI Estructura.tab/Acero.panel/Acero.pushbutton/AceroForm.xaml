<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acero - Columnas"
        Height="880" Width="1560" MinWidth="1200" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="window_key">
    <DockPanel Margin="12">
        <!-- Bottom: run (the columns picked in the model, or else every
             column of the checked types) -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" x:Name="button_run" Content="Generar acero..." Width="220" Height="40"
                    FontWeight="Bold" Click="run_click"
                    ToolTip="Guarda la configuraci&#243;n en el tipo y genera el acero de las columnas seleccionadas (si no hay ninguna seleccionada, de todas las columnas de los tipos marcados)."/>
            <Button DockPanel.Dock="Right" Content="Abrir archivo..." Width="130" Height="40" Margin="0,0,8,0" Click="file_open_click"
                    ToolTip="Carga una configuraci&#243;n guardada (estribos, barras y dibujo de la secci&#243;n)."/>
            <Button DockPanel.Dock="Right" Content="Guardar en archivo..." Width="150" Height="40" Margin="0,0,8,0" Click="file_save_click"
                    ToolTip="Guarda la configuraci&#243;n y el dibujo de la secci&#243;n en un archivo, para usarlos en otro tipo o proyecto."/>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="col_shapes" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Left: types + configuration -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="1. Marca los tipos a configurar (o selecciona columnas en el modelo)."/>
                <Button DockPanel.Dock="Top" x:Name="button_pick" Content="SELECCIONAR COLUMNAS" Height="34"
                        FontWeight="Bold" Click="pick_click"/>
                <TextBlock DockPanel.Dock="Top" x:Name="txt_picked" Foreground="Gray" HorizontalAlignment="Center"
                           Margin="0,4,0,6" Text="No hay columnas seleccionadas en el modelo."/>
                <CheckBox DockPanel.Dock="Top" x:Name="chk_all" Content="Seleccionar todo" Margin="0,0,0,4"
                          Click="all_click"/>

                <!-- Lap splices of the longitudinal bars (settings kept per user) -->
                <Expander DockPanel.Dock="Bottom" Header="4. Empalme de barras longitudinales" Margin="0,8,0,0">
                    <StackPanel Margin="6,4,6,4">
                        <CheckBox x:Name="chk_splice" Click="splice_changed"
                                  Content="Barras continuas en columnas apiladas, con empalme"
                                  ToolTip="Activado: las barras longitudinales siguen continuas por las columnas apiladas que generas (mismo tipo y eje, una sobre otra; al seleccionar, solo las seleccionadas); cuando superan la longitud maxima se cortan con un empalme en la mitad central de un piso. Desactivado: una barra por columna."/>
                        <StackPanel Orientation="Horizontal" Margin="18,4,0,4"
                                    IsEnabled="{Binding IsChecked, ElementName=chk_splice}">
                            <TextBlock Text="Longitud maxima de barra: " VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_splice_max" Width="45" TextChanged="splice_changed"/>
                            <TextBlock Text=" m" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Empalme por diametro: marca los que se empalman (cm; sugerido E.060 clase B):" TextWrapping="Wrap" Margin="0,2,0,2"/>
                        <WrapPanel x:Name="panel_laps" IsEnabled="{Binding IsChecked, ElementName=chk_splice}"/>
                    </StackPanel>
                </Expander>

                <!-- Vertical bars: four diameters (drawing tool) and their Revit bar type -->
                <Expander DockPanel.Dock="Bottom" Header="3. Configuraci&#243;n de barra vertical" Margin="0,8,0,0" Padding="6,4,6,6" IsExpanded="False">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>
                        <RadioButton Grid.Row="1" x:Name="rb_bar_1" GroupName="tool" Content="&#216;" VerticalAlignment="Center"
                                     Checked="tool_changed" ToolTip="Elige esta barra y haz clic en la planta donde va cada una."/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cbo_bar_1" VerticalAlignment="Center" SelectionChanged="bar_slot_changed"
                                  ToolTip="Di&#225;metro de esta opci&#243;n: elige el que uses; se recuerda la pr&#243;xima vez."/>
                        <ComboBox Grid.Row="1" Grid.Column="2" x:Name="cbo_bar_type_1" Margin="4,0,0,0" VerticalAlignment="Center"
                                  SelectionChanged="bar_type_changed"
                                  ToolTip="Tipo de barra de armadura de Revit de este di&#225;metro (todos los del proyecto). Autom&#225;tico: el del tipo de columna."/>
                        <RadioButton Grid.Row="2" x:Name="rb_bar_2" GroupName="tool" Content="&#216;" VerticalAlignment="Center"
                                     Checked="tool_changed" ToolTip="Elige esta barra y haz clic en la planta donde va cada una."/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cbo_bar_2" VerticalAlignment="Center" SelectionChanged="bar_slot_changed"
                                  ToolTip="Di&#225;metro de esta opci&#243;n: elige el que uses; se recuerda la pr&#243;xima vez."/>
                        <ComboBox Grid.Row="2" Grid.Column="2" x:Name="cbo_bar_type_2" Margin="4,0,0,0" VerticalAlignment="Center"
                                  SelectionChanged="bar_type_changed"
                                  ToolTip="Tipo de barra de armadura de Revit de este di&#225;metro (todos los del proyecto). Autom&#225;tico: el del tipo de columna."/>
                        <RadioButton Grid.Row="3" x:Name="rb_bar_3" GroupName="tool" Content="&#216;" VerticalAlignment="Center"
                                     Checked="tool_changed" ToolTip="Elige esta barra y haz clic en la planta donde va cada una."/>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cbo_bar_3" VerticalAlignment="Center" SelectionChanged="bar_slot_changed"
                                  ToolTip="Di&#225;metro de esta opci&#243;n: elige el que uses; se recuerda la pr&#243;xima vez."/>
                        <ComboBox Grid.Row="3" Grid.Column="2" x:Name="cbo_bar_type_3" Margin="4,0,0,0" VerticalAlignment="Center"
                                  SelectionChanged="bar_type_changed"
                                  ToolTip="Tipo de barra de armadura de Revit de este di&#225;metro (todos los del proyecto). Autom&#225;tico: el del tipo de columna."/>
                        <RadioButton Grid.Row="4" x:Name="rb_bar_4" GroupName="tool" Content="&#216;" VerticalAlignment="Center"
                                     Checked="tool_changed" ToolTip="Elige esta barra y haz clic en la planta donde va cada una."/>
                        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="cbo_bar_4" VerticalAlignment="Center" SelectionChanged="bar_slot_changed"
                                  ToolTip="Di&#225;metro de esta opci&#243;n: elige el que uses; se recuerda la pr&#243;xima vez."/>
                        <ComboBox Grid.Row="4" Grid.Column="2" x:Name="cbo_bar_type_4" Margin="4,0,0,0" VerticalAlignment="Center"
                                  SelectionChanged="bar_type_changed"
                                  ToolTip="Tipo de barra de armadura de Revit de este di&#225;metro (todos los del proyecto). Autom&#225;tico: el del tipo de columna."/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Pata inf. (m)" FontSize="9" HorizontalAlignment="Center"
                                   ToolTip="Pata (doblez) al pie de la barra, dentro de la cimentaci&#243;n, en metros (ej. 0.25). Vac&#237;o: sin pata."/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Pata sup. (m)" FontSize="9" HorizontalAlignment="Center"
                                   ToolTip="Pata (doblez) donde termina la barra, en el &#250;ltimo piso, en metros (ej. 0.20). Vac&#237;o: sin pata."/>
                        <TextBox Grid.Row="1" Grid.Column="3" x:Name="txt_leg_bot_1" Margin="4,0,0,0" VerticalAlignment="Center" TextChanged="leg_changed"/>
                        <TextBox Grid.Row="1" Grid.Column="4" x:Name="txt_leg_top_1" Margin="4,0,0,0" VerticalAlignment="Center" TextChanged="leg_changed"/>
                        <TextBox Grid.Row="2" Grid.Column="3" x:Name="txt_leg_bot_2" Margin="4,0,0,0" VerticalAlignment="Center" TextChanged="leg_changed"/>
                        <TextBox Grid.Row="2" Grid.Column="4" x:Name="txt_leg_top_2" Margin="4,0,0,0" VerticalAlignment="Center" TextChanged="leg_changed"/>
                        <TextBox Grid.Row="3" Grid.Column="3" x:Name="txt_leg_bot_3" Margin="4,0,0,0" VerticalAlignment="Center" TextChanged="leg_changed"/>
                        <TextBox Grid.Row="3" Grid.Column="4" x:Name="txt_leg_top_3" Margin="4,0,0,0" VerticalAlignment="Center" TextChanged="leg_changed"/>
                        <TextBox Grid.Row="4" Grid.Column="3" x:Name="txt_leg_bot_4" Margin="4,0,0,0" VerticalAlignment="Center" TextChanged="leg_changed"/>
                        <TextBox Grid.Row="4" Grid.Column="4" x:Name="txt_leg_top_4" Margin="4,0,0,0" VerticalAlignment="Center" TextChanged="leg_changed"/>
                        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="Anclaje (m):" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="5" Grid.Column="2" x:Name="txt_anchor" Margin="4,0,0,0" VerticalAlignment="Center" TextChanged="config_changed"
                                 ToolTip="Cu&#225;nto baja la barra dentro de la zapata, cimiento o losa de cimentaci&#243;n. Vac&#237;o: hasta la malla del fondo. Tambi&#233;n se edita con un clic en la cota del alzado."/>
                        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="Pata abajo:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="6" Grid.Column="2" x:Name="cbo_dir_bot" Margin="4,0,0,0" VerticalAlignment="Center" SelectionChanged="config_changed"
                                  ToolTip="Hacia d&#243;nde apunta la pata de abajo: afuera o adentro de la columna."/>
                        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="Pata arriba:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="7" Grid.Column="2" x:Name="cbo_dir_top" Margin="4,0,0,0" VerticalAlignment="Center" SelectionChanged="config_changed"
                                  ToolTip="Hacia d&#243;nde apunta la pata de arriba: adentro de la columna o afuera, dentro de la viga o losa."/>
                    </Grid>
                </Expander>

                <Expander DockPanel.Dock="Bottom" Header="2. Configuraci&#243;n de estribos" Margin="0,8,0,0" Padding="6,4,6,6" IsExpanded="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Confinamiento &#216; / Tipo:" VerticalAlignment="Center"
                                   ToolTip="Estribos interiores (los que no abrazan todas las barras) y grapas."/>
                        <DockPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            <ComboBox DockPanel.Dock="Left" x:Name="cbo_conf" Width="62" SelectionChanged="stirrup_diameter_changed"/>
                            <ComboBox x:Name="cbo_conf_type" Margin="4,0,0,0" SelectionChanged="stirrup_type_changed"
                                      ToolTip="Tipo de barra de armadura de Revit para estos estribos y grapas (del di&#225;metro elegido). Autom&#225;tico: el del tipo de columna."/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="     Distribuci&#243;n:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txt_conf_dist" TextChanged="config_changed" VerticalAlignment="Center"
                                 ToolTip="Desde cada extremo, en la luz libre. Ej. 1@5 6@10 Rto@25. Vacio si no hay estribos interiores ni grapas."/>
                        <TextBlock Grid.Row="2" Text="Borde &#216; / Tipo:" VerticalAlignment="Center"
                                   ToolTip="Estribo perimetral (el que abraza todas las barras)."/>
                        <DockPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                            <ComboBox DockPanel.Dock="Left" x:Name="cbo_edge" Width="62" SelectionChanged="stirrup_diameter_changed"/>
                            <ComboBox x:Name="cbo_edge_type" Margin="4,0,0,0" SelectionChanged="stirrup_type_changed"
                                      ToolTip="Tipo de barra de armadura de Revit para el estribo de borde (del di&#225;metro elegido). Autom&#225;tico: el del tipo de columna."/>
                        </DockPanel>
                        <TextBlock Grid.Row="3" Text="     Distribuci&#243;n:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="txt_edge_dist" TextChanged="config_changed" VerticalAlignment="Center"
                                 ToolTip="Desde cada extremo, en la luz libre. Ej. 1@5 6@10 Rto@25  o  1@.05, 10@.10, rto@.20"/>
                        <CheckBox Grid.Row="4" x:Name="chk_izaje" Content="Izaje &#216; / Tipo:" VerticalAlignment="Center" Click="config_changed"
                                  ToolTip="Activa los estribos de izaje: sobre la zapata, desde la altura de izaje hacia abajo. Desact&#237;valo cuando el elemento no los requiera."/>
                        <DockPanel Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"
                                   IsEnabled="{Binding IsChecked, ElementName=chk_izaje}">
                            <ComboBox DockPanel.Dock="Left" x:Name="cbo_izaje" Width="62" SelectionChanged="config_changed"/>
                            <ComboBox x:Name="cbo_izaje_type" Margin="4,0,0,0" SelectionChanged="stirrup_type_changed"
                                      ToolTip="Tipo de barra de armadura de Revit para los estribos de izaje. Autom&#225;tico: el del tipo de columna."/>
                        </DockPanel>
                        <TextBlock Grid.Row="5" Text="     Distribuci&#243;n:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="txt_izaje_dist" TextChanged="config_changed" VerticalAlignment="Center"
                                 IsEnabled="{Binding IsChecked, ElementName=chk_izaje}"
                                 ToolTip="Desde la altura de izaje hacia abajo, hasta la cara de la zapata. Ej. 9@0.15. Vac&#237;o: sin izaje."/>
                        <TextBlock Grid.Row="6" Text="     Altura izaje (m):" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="txt_izaje_h" TextChanged="config_changed" VerticalAlignment="Center"
                                 IsEnabled="{Binding IsChecked, ElementName=chk_izaje}"
                                 ToolTip="Desde la cara superior de la zapata. Sobre esta cota empieza la distribuci&#243;n normal de la columna. Tambi&#233;n se edita con un clic en la cota del alzado."/>
                        <TextBlock Grid.Row="7" Text="Recubrimiento (cm):" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="7" Grid.Column="1" x:Name="txt_cover" TextChanged="config_changed" VerticalAlignment="Center"/>
                        <CheckBox Grid.Row="8" x:Name="chk_nucleo" Click="config_changed" Content="Estribo en n&#250;cleo" VerticalAlignment="Center"
                                  ToolTip="Estribos tambien dentro del nudo viga-columna (desde el fondo de la viga hasta el tope)."/>
                        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    IsEnabled="{Binding IsChecked, ElementName=chk_nucleo}">
                            <TextBlock Text="@ " VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_nucleo" TextChanged="config_changed" Width="50"/>
                            <TextBlock Text=" cm" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Row="9" Grid.ColumnSpan="2" x:Name="button_save" Visibility="Collapsed" Margin="0,8,0,0" Height="30"
                                Content="Guardar configuraci&#243;n en los tipos marcados" Click="save_click"
                                ToolTip="La configuraci&#243;n queda en el tipo: la usan todas sus columnas, en todos los niveles."/>
                    </Grid>
                </Expander>


                <ListBox x:Name="list_types" SelectionMode="Single" SelectionChanged="type_selected"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>

            <!-- Right: section drawing -->
            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" x:Name="txt_section" FontWeight="Bold" Margin="0,0,0,4"
                           Text="Seccion: elige un tipo en la lista"/>
                <!-- Custom stirrup sketch ("Boceto"): tool + the steel it uses -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="Boceto: " FontWeight="Bold" VerticalAlignment="Center"/>
                    <RadioButton x:Name="rb_stirrup" GroupName="tool" Content="Estribo" IsChecked="True" Margin="4,0,8,0"
                                 VerticalAlignment="Center" Checked="tool_changed"/>
                    <RadioButton x:Name="rb_rect" GroupName="tool" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Checked="tool_changed"
                                 ToolTip="Estribo rectangular: clic en dos esquinas opuestas (se ajustan a las barras y a 1 cm).">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="18" Height="18" Margin="0,0,4,0">
                                <Rectangle Canvas.Left="2" Canvas.Top="2" Width="14" Height="14"
                                           Stroke="#FF5A5A5A" StrokeThickness="1.5"/>
                                <Rectangle Canvas.Left="0" Canvas.Top="0" Width="5" Height="5" Fill="#FF2F7FE0"/>
                                <Rectangle Canvas.Left="13" Canvas.Top="13" Width="5" Height="5" Fill="#FF2F7FE0"/>
                            </Canvas>
                            <TextBlock Text="Mediante dos puntos" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="rb_tie" GroupName="tool" Content="Grapa" Margin="0,0,8,0"
                                 VerticalAlignment="Center" Checked="tool_changed"/>
                    <RadioButton x:Name="rb_edit" GroupName="tool" Content="Editar" Margin="0,0,8,0"
                                 VerticalAlignment="Center" Checked="tool_changed"
                                 ToolTip="Clic en un estribo para ver y cambiar sus medidas y su tipo (borde/confinamiento)."/>
                    <RadioButton x:Name="rb_erase" GroupName="tool" Content="Borrar" Margin="0,0,16,0"
                                 VerticalAlignment="Center" Checked="tool_changed"/>
                    <TextBlock Text="&#216; acero: " VerticalAlignment="Center"/>
                    <ComboBox x:Name="cbo_steel" Width="190" Margin="0,0,12,0" SelectionChanged="steel_changed"
                              ToolTip="Estribo y Grapa: el di&#225;metro de la configuraci&#243;n de estribos (borde o confinamiento)."/>
                    <Button Content="Deshacer" Width="70" Margin="0,0,4,0" Click="undo_click"/>
                    <Button Content="Limpiar" Width="65" Margin="0,0,4,0" Click="clear_click"/>
                </WrapPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="Estribo: " VerticalAlignment="Center"/>
                    <RadioButton x:Name="rb_shape_closed" GroupName="shape" Content="Cerrado" IsChecked="True"
                                 Margin="0,0,8,0" VerticalAlignment="Center"
                                 ToolTip="Clic en cada barra y clic derecho (o clic en la primera) para cerrarlo."/>
                    <RadioButton x:Name="rb_shape_open" GroupName="shape" Content="Abierto (U)" Margin="0,0,12,0"
                                 VerticalAlignment="Center"
                                 ToolTip="Clic en cada punto por las barras que abraza y clic derecho para terminarlo sin cerrar (ej. estribo de confinamiento en U)."/>
                    <TextBlock Text="Grapa: " VerticalAlignment="Center"
                               ToolTip="Tipo de las grapas que coloques con la herramienta Grapa."/>
                    <RadioButton x:Name="rb_tie_135" GroupName="tiestyle" Content="135&#176;" IsChecked="True"
                                 Margin="0,0,6,0" VerticalAlignment="Center" Checked="tie_style_changed"
                                 ToolTip="Ganchos de estribo de 135&#176;."/>
                    <RadioButton x:Name="rb_tie_c" GroupName="tiestyle" Content="C 180&#176;" Margin="0,0,6,0"
                                 VerticalAlignment="Center" Checked="tie_style_changed"
                                 ToolTip="Ganchos de 180&#176; hacia el mismo lado (grapa en C)."/>
                    <RadioButton x:Name="rb_tie_s" GroupName="tiestyle" Content="S 180&#176;" Margin="0,0,14,0"
                                 VerticalAlignment="Center" Checked="tie_style_changed"
                                 ToolTip="Ganchos de 180&#176; hacia lados opuestos (grapa en S)."/>
                    <TextBlock Text="Pata (cm): " VerticalAlignment="Center"/>
                    <TextBox x:Name="tb_tie_leg" Width="40" Margin="0,0,14,0" VerticalAlignment="Center"
                             TextChanged="tie_leg_changed"
                             ToolTip="Largo recto del gancho de las grapas (cm). Vac&#237;o = m&#237;nimo E.060 (180&#176;: 4db y 6.5 cm; 135&#176;: 6db y 7.5 cm)."/>
                    <Button x:Name="button_shapes" Content="Mostrar formas" Padding="6,0" Margin="0,0,6,0"
                            VerticalAlignment="Center" Click="shapes_toggle_click"
                            ToolTip="Muestra u oculta el panel Formas de armadura."/>
                    <TextBlock Text="Forma: " VerticalAlignment="Center"/>
                    <TextBlock x:Name="txt_active_shape" Text="la que elija Revit" FontWeight="Bold" Margin="0,0,20,0"
                               VerticalAlignment="Center"
                               ToolTip="Forma de armadura de los estribos (o grapas) que dibujes. Se elige con un clic en el panel Formas de armadura."/>
                </WrapPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="txt_status" Foreground="#FFC0392B" FontWeight="Bold"
                           TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed"/>
                <!-- Measures of the selected stirrup (outer face, cm) -->
                <Border DockPanel.Dock="Top" x:Name="panel_measures" Visibility="Collapsed" Margin="0,0,0,4"
                        Padding="6,4,6,4" Background="#FFEAF2FC" BorderBrush="#FF9DBEE8" BorderThickness="1">
                    <WrapPanel>
                        <TextBlock x:Name="txt_measures_title" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Text="Estribo seleccionado - medidas exteriores (cm):"/>
                        <StackPanel x:Name="panel_rect_fields" Orientation="Horizontal">
                            <TextBlock Text="Ancho " VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_m_width" Width="48" Margin="0,0,8,0" KeyDown="measure_key"/>
                            <TextBlock Text="Alto " VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_m_height" Width="48" Margin="0,0,8,0" KeyDown="measure_key"/>
                            <Button Content="Aplicar" Width="65" Click="measures_apply"
                                    ToolTip="Cambia el tama&#241;o alrededor de su centro, sin salir del recubrimiento."/>
                        </StackPanel>
                        <!-- Open stirrups: one box per segment (filled in code) -->
                        <StackPanel x:Name="panel_segments" Orientation="Horizontal"
                                    ToolTip="Cambia un tramo y pulsa Aplicar (o Enter): crece en su misma direccion y lo que sigue se desplaza, sin cambiar los angulos."/>
                        <TextBlock x:Name="txt_m_sides" VerticalAlignment="Center" Foreground="#FF404040"/>
                        <Button Content="Eliminar estribo" Width="110" Margin="12,0,0,0" Foreground="#FFC0392B"
                                Click="delete_stirrup_click"
                                ToolTip="Borra el estribo seleccionado (tecla Supr). Deshacer lo recupera."/>
                    </WrapPanel>
                </Border>
                <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,4,0,0"
                           Text="Estribo cerrado: clic en cada barra que abraza y clic derecho (o clic en la primera) para cerrarlo; abierto (U): clic en cada punto y clic derecho para terminarlo sin cerrar. Esc cancela el trazo. Mediante dos puntos: clic en dos esquinas opuestas. Al crear un estribo (o con Editar) aparecen sus medidas para modificarlas. Grapa: un clic donde la quieres; se coloca sola entre las dos barras enfrentadas mas cercanas. En '&#216; acero' eliges si usa el estribo de borde (naranja) o de confinamiento (verde). Barras: elige una de las 4 opciones (el di&#225;metro de cada una se cambia en su lista y se recuerda) y haz clic en la planta donde va cada barra (cerca de un estribo se pega a su cara interior); Borrar quita una barra. Los puntos se ajustan a las barras y a 1 cm. Forma: clic en una forma de armadura (panel derecho) y dibuja el estribo; se crea con esa forma. El boceto se guarda con 'Guardar configuracion' en los tipos marcados de la misma seccion."/>
                <!-- Three views: 3D (large, left), elevation and plan (the sketch). Mouse wheel
                     zooms, middle button drag pans, "Ajustar" refits; in 3D a
                     left drag orbits. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Column="1" Grid.Row="1">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                            <Button DockPanel.Dock="Right" Content="Ajustar" Width="60" Click="plan_fit_click"/>
                            <TextBlock Text="PLANTA" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border BorderBrush="#FF9A9A9A" BorderThickness="1" Background="White" ClipToBounds="True">
                            <Canvas x:Name="canvas" Background="White"
                                    MouseLeftButtonDown="canvas_left" MouseRightButtonDown="canvas_right"
                                    MouseMove="canvas_move" SizeChanged="canvas_resized"
                                    MouseWheel="plan_wheel" MouseDown="plan_mouse_down" MouseUp="plan_mouse_up"/>
                        </Border>
                    </DockPanel>

                    <DockPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,6">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                            <Button DockPanel.Dock="Right" Content="Ajustar" Width="60" Click="elev_fit_click"/>
                            <TextBlock Text="ALZADO" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border BorderBrush="#FF9A9A9A" BorderThickness="1" Background="White" ClipToBounds="True">
                            <Canvas x:Name="canvas_elev" Background="White" SizeChanged="elev_resized"
                                    MouseWheel="elev_wheel" MouseDown="elev_mouse_down" MouseUp="elev_mouse_up"
                                    MouseMove="elev_mouse_move"/>
                        </Border>
                    </DockPanel>

                    <DockPanel Grid.Column="0" Grid.RowSpan="2" Margin="0,0,6,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                            <Button DockPanel.Dock="Right" Content="Ajustar" Width="60" Click="view3d_fit_click"/>
                            <ComboBox DockPanel.Dock="Right" x:Name="cbo_detail" Width="80" Margin="0,0,6,0"
                                      SelectionChanged="detail_changed"/>
                            <TextBlock DockPanel.Dock="Right" Text="Nivel de detalle: " VerticalAlignment="Center"/>
                            <TextBlock Text="VISTA 3D" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="Columna: " VerticalAlignment="Center"/>
                            <ComboBox x:Name="cbo_view_column" SelectionChanged="view_column_changed"
                                      ToolTip="Cual de las columnas de este tipo se ve en la vista 3D y el alzado; entre parentesis, lo que toca (viga, losa, zapata)."/>
                        </DockPanel>
                        <Border x:Name="border3d" BorderBrush="#FF9A9A9A" BorderThickness="1" Background="White"
                                ClipToBounds="True"
                                MouseWheel="view3d_wheel" MouseDown="view3d_mouse_down" MouseUp="view3d_mouse_up"
                                MouseMove="view3d_mouse_move" SizeChanged="view3d_resized">
                            <Viewport3D x:Name="view3d"/>
                        </Border>
                    </DockPanel>
                </Grid>
            </DockPanel>

            <!-- Right: rebar shape browser, always shown -->
            <GroupBox Grid.Column="2" x:Name="box_shapes" Visibility="Collapsed" Header="Formas de armadura" Margin="10,0,0,0" Padding="4">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="Buscar: " VerticalAlignment="Center"/>
                        <TextBox x:Name="txt_shape_filter" TextChanged="shape_filter_changed"/>
                    </DockPanel>
                    <CheckBox DockPanel.Dock="Top" x:Name="chk_shape_stirrups" Content="Solo formas de estribo"
                              IsChecked="False" Margin="0,0,0,4" Click="shape_filter_changed"/>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button Content="Quitar forma elegida" Height="28" Margin="0,0,0,4"
                                Click="shape_clear_click"
                                ToolTip="Los estribos y grapas que dibujes despues toman la forma que Revit elija."/>
                        <Button Content="Cargar forma (.rfa)..." Height="26" Click="shape_load_click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,4,0,0"
                               Text="Clic en una forma para elegirla y luego dibuja el estribo en la planta: se crea con esa forma en Revit. Una forma recta (con ganchos) se usa para las grapas."/>
                    <ListBox x:Name="list_shapes" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="shape_selected"/>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
