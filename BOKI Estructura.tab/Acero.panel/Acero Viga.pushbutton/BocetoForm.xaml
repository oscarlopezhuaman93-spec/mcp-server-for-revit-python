<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Boceto de barra" Height="640" Width="980" MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" Background="#FFF3F5F8">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFD0D7DF"/>
            <Setter Property="Foreground" Value="#FF16324F"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF2D8CF0"/>
            <Setter Property="Foreground" Value="#FF1F6FC5"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF16324F" Padding="16,8,16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="BOKI" Foreground="#FFFFB347" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="ACERO VIGA &#183; BOCETO DE BARRA" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Foreground="#FFB9C9DA" FontSize="11"
                               Text="Dibuja la barra punto a punto en una elevaci&#243;n o corte: cada punto es un doblez. Luego ajusta la longitud de cada tramo."/>
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel Margin="12">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="CREAR BARRA" Width="200" Height="40" FontWeight="Bold"
                        Background="#FF2D8CF0" Foreground="White" BorderThickness="0" Click="create_click"/>
                <Button DockPanel.Dock="Right" Content="Volver a Acero Viga" Width="160" Height="40" Margin="0,0,8,0" Click="close_click"/>
                <TextBlock x:Name="txt_status" VerticalAlignment="Center" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="560"/>
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" Margin="0,0,10,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="Barra">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                <TextBlock Text="Di&#225;metro:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="cbo_d" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="Cantidad:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txt_n" Text="2" VerticalAlignment="Center"
                                         ToolTip="Las barras se reparten en el ancho de la viga, dentro del recubrimiento."/>
                                <TextBlock Grid.Row="2" Text="Recubrimiento (cm):" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txt_cover" Text="4" VerticalAlignment="Center"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Dibujo">
                            <StackPanel>
                                <Button Content="&#9998;  Dibujar en la vista" Height="34" FontWeight="Bold" Background="#FF2D8CF0"
                                        Foreground="White" BorderThickness="0" Click="draw_click"
                                        ToolTip="Selecciona la viga y haz clic en cada punto de la barra (Esc para terminar)."/>
                                <TextBlock x:Name="txt_host" Foreground="Gray" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Longitud de cada tramo (m)">
                            <StackPanel>
                                <StackPanel x:Name="pnl_segments"/>
                                <Button Content="Aplicar longitudes" Height="28" Margin="0,6,0,0" Click="apply_click"/>
                                <TextBlock x:Name="txt_total" FontWeight="Bold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
                <GroupBox Grid.Column="1" Header="VISTA DE LA BARRA (en el plano de la viga)">
                    <Canvas x:Name="canvas" Background="White" ClipToBounds="True" SizeChanged="resized"/>
                </GroupBox>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
