<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acero - Losa"
        Height="900" Width="1600" MinWidth="1200" MinHeight="660"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" x:Name="button_run" Content="Generar acero..." Width="220" Height="40"
                    FontWeight="Bold" Click="run_click"
                    ToolTip="Guarda la configuraci&#243;n en cada losa marcada y genera sus barras (reemplaza las generadas antes)."/>
            <TextBlock DockPanel.Dock="Left" x:Name="txt_status" Foreground="Gray" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="1000"/>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: slabs + configuration -->
            <ScrollViewer Grid.Column="0" Margin="0,0,10,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="1. Selecciona las losas (macizas o aligeradas)."/>
                <Button Content="SELECCIONAR LOSAS" Height="34" FontWeight="Bold" Click="pick_click"/>
                <Button Content="CREAR LOSAS NUEVAS (planas o inclinadas)" Height="30" Margin="0,4,0,0" Click="create_slabs_click"
                        ToolTip="Abre Crear Losas: paños entre vigas y muros, rect&#225;ngulo o contorno; plana, una, dos o cuatro aguas, con el tipo de losa del proyecto. Al terminar vuelve aqu&#237; con las losas nuevas."/>
                <TextBlock x:Name="txt_picked" Foreground="Gray" HorizontalAlignment="Center" Margin="0,4,0,6" Text="No hay losas seleccionadas."/>
                <ListBox x:Name="list_elements" MaxHeight="110" SelectionChanged="element_selected"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                <TabControl x:Name="tabs" Margin="0,8,0,0">
                <TabItem Header="Acero">
                <Expander Header="2. Acero de la losa" Margin="0,4,0,0" IsExpanded="True">
                    <StackPanel Margin="6,4,6,4">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Recubrimiento: " VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_cover" Width="40" TextChanged="form_changed"/>
                            <TextBlock Text=" cm    Espesor: " VerticalAlignment="Center"/>
                            <TextBlock x:Name="txt_thick" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Tipo de losa: " VerticalAlignment="Center" FontWeight="Bold"/>
                            <ComboBox x:Name="cbo_kind" Width="150" SelectionChanged="form_changed"/>
                        </StackPanel>

                        <StackPanel x:Name="panel_maciza">
                        <CheckBox x:Name="chk_inf" Content="Malla inferior (corrida, se empalma)" FontWeight="Bold" Margin="0,4,0,2" Click="form_changed"/>
                        <StackPanel Orientation="Horizontal" Margin="16,1,0,1" IsEnabled="{Binding IsChecked, ElementName=chk_inf}">
                            <TextBlock Text="X  &#216; " VerticalAlignment="Center" Foreground="#FF1D9E75" FontWeight="Bold"/>
                            <ComboBox x:Name="cbo_ix_d" Width="58" SelectionChanged="form_changed"/>
                            <TextBlock Text=" @ " VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_ix_s" Width="40" TextChanged="form_changed"/>
                            <TextBlock Text=" m" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,1,0,1" IsEnabled="{Binding IsChecked, ElementName=chk_inf}">
                            <TextBlock Text="Y  &#216; " VerticalAlignment="Center" Foreground="#FF2A6FD6" FontWeight="Bold"/>
                            <ComboBox x:Name="cbo_iy_d" Width="58" SelectionChanged="form_changed"/>
                            <TextBlock Text=" @ " VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_iy_s" Width="40" TextChanged="form_changed"/>
                            <TextBlock Text=" m" VerticalAlignment="Center"/>
                        </StackPanel>

                        <CheckBox x:Name="chk_sup" Content="Acero superior" FontWeight="Bold" Margin="0,8,0,2" Click="form_changed"/>
                        <StackPanel Orientation="Horizontal" Margin="16,1,0,1" IsEnabled="{Binding IsChecked, ElementName=chk_sup}">
                            <ComboBox x:Name="cbo_mode" Width="150" SelectionChanged="form_changed"/>
                            <TextBlock Text="  Ln / " VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_frac" Width="30" TextChanged="form_changed"
                                     ToolTip="Largo de cada bast&#243;n desde la cara del apoyo: la luz libre del pa&#241;o entre este n&#250;mero (3 = Ln/3). Cada apoyo se edita en los cortes."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,1,0,1" IsEnabled="{Binding IsChecked, ElementName=chk_sup}">
                            <TextBlock Text="X  &#216; " VerticalAlignment="Center" Foreground="#FFD23C3C" FontWeight="Bold"/>
                            <ComboBox x:Name="cbo_sx_d" Width="58" SelectionChanged="form_changed"/>
                            <TextBlock Text=" @ " VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_sx_s" Width="40" TextChanged="form_changed"/>
                            <TextBlock Text=" m" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,1,0,1" IsEnabled="{Binding IsChecked, ElementName=chk_sup}">
                            <TextBlock Text="Y  &#216; " VerticalAlignment="Center" Foreground="#FFF08C14" FontWeight="Bold"/>
                            <ComboBox x:Name="cbo_sy_d" Width="58" SelectionChanged="form_changed"/>
                            <TextBlock Text=" @ " VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_sy_s" Width="40" TextChanged="form_changed"/>
                            <TextBlock Text=" m" VerticalAlignment="Center"/>
                        </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="panel_alig" Visibility="Collapsed">
                            <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,2"
                                       Text="La distribuci&#243;n de viguetas y los ladrillos est&#225;n en la pesta&#241;a 'Ladrillos de techo'."/>
                            <Border x:Name="panel_roof" Visibility="Collapsed" Background="#FFFFF4D6" BorderBrush="#FFE0B050"
                                    BorderThickness="1" Padding="6,4" Margin="0,8,0,2">
                                <StackPanel>
                                    <TextBlock x:Name="txt_roof" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <CheckBox x:Name="chk_roof" Content="Tratar como un solo techo (acero por la cumbrera)" Margin="0,3,0,3" Click="form_changed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                        <TextBlock Text="Inferior en la cumbrera: " VerticalAlignment="Center" Width="150"/>
                                        <ComboBox x:Name="cbo_roof_inf" Width="150" SelectionChanged="form_changed"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                        <TextBlock Text="Bast&#243;n de cumbrera: " VerticalAlignment="Center" Width="150"/>
                                        <ComboBox x:Name="cbo_roof_sup" Width="150" SelectionChanged="form_changed"/>
                                    </StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Text="En el corte de la vigueta: clic en un doblez (c&#237;rculo naranja) para el modo; clic en una cota amarilla para su largo sobre la pendiente (vac&#237;o = autom&#225;tico)."/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Acero por vigueta" FontWeight="Bold" Margin="0,8,0,2"/>
                            <StackPanel Orientation="Horizontal" Margin="16,1,0,1">
                                <TextBlock Text="Inferior 1 &#216; " VerticalAlignment="Center" Foreground="#FF1D9E75" FontWeight="Bold"/>
                                <ComboBox x:Name="cbo_vi_d" Width="58" SelectionChanged="form_changed"/>
                                <TextBlock Text="  corrido" VerticalAlignment="Center" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="16,1,0,1">
                                <TextBlock Text="Bastones 1 &#216; " VerticalAlignment="Center" Foreground="#FFD23C3C" FontWeight="Bold"/>
                                <ComboBox x:Name="cbo_vs_d" Width="58" SelectionChanged="form_changed"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="16,1,0,1">
                                <TextBlock Text="extremo Ln / " VerticalAlignment="Center"/>
                                <TextBox x:Name="txt_vend" Width="30" TextChanged="form_changed"/>
                                <TextBlock Text="   interior Ln / " VerticalAlignment="Center"/>
                                <TextBox x:Name="txt_vint" Width="30" TextChanged="form_changed"/>
                            </StackPanel>
                            <CheckBox x:Name="chk_temp" Content="Temperatura (perpendicular, en la losa de 5 cm)" FontWeight="Bold" Margin="0,8,0,2" Click="form_changed"/>
                            <StackPanel Orientation="Horizontal" Margin="16,1,0,1" IsEnabled="{Binding IsChecked, ElementName=chk_temp}">
                                <TextBlock Text="&#216; " VerticalAlignment="Center" Foreground="#FF2A6FD6" FontWeight="Bold"/>
                                <ComboBox x:Name="cbo_t_d" Width="58" SelectionChanged="form_changed"/>
                                <TextBlock Text=" @ " VerticalAlignment="Center"/>
                                <TextBox x:Name="txt_t_s" Width="40" TextChanged="form_changed"/>
                                <TextBlock Text=" m" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                            <TextBlock Text="Anclaje en los bordes: " VerticalAlignment="Center"/>
                            <ComboBox x:Name="cbo_anchor" Width="100" SelectionChanged="form_changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,1,0,1">
                            <TextBlock Text="Pata del gancho " VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_leg" Width="40" TextChanged="form_changed"
                                     ToolTip="Largo de la pata (m). Vac&#237;o: 12 db, hasta 5 cm (y nunca m&#225;s de lo que cabe en la losa)."/>
                            <TextBlock Text=" m (vac&#237;o: 12 db)" VerticalAlignment="Center" Foreground="Gray"/>
                        </StackPanel>
                        <TextBlock x:Name="txt_splice" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,10,0,0"/>
                    </StackPanel>
                </Expander>
                </TabItem>
                <TabItem Header="Ladrillos de techo">
                    <StackPanel Margin="6,6,6,4">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="Solo para losas aligeradas. Coloca los ladrillos de techo sin tocar el acero (en losas inclinadas, inclinados con la pendiente)."/>
                        <TextBlock x:Name="txt_bricks_kind" Foreground="#FFB02020" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="Viguetas" FontWeight="Bold" Margin="0,2,0,2"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                <TextBlock Text="Viguetas en: " VerticalAlignment="Center"/>
                                <ComboBox x:Name="cbo_dir" Width="150" SelectionChanged="form_changed"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="16,1,0,1">
                                <TextBlock Text="Girar " VerticalAlignment="Center"/>
                                <TextBox x:Name="txt_angle" Width="40" TextChanged="form_changed"
                                         ToolTip="Direcci&#243;n de las viguetas y los ladrillos (grados, antihorario desde X). Vac&#237;o: a lo largo del lado m&#225;s largo de la losa (sus vigas). Tambi&#233;n con &quot;Elegir direcci&#243;n&quot; en la planta."/>
                                <TextBlock Text=" &#176;   Inicio desde la cara " VerticalAlignment="Center"/>
                                <TextBox x:Name="txt_start" Width="36" TextChanged="form_changed"
                                         ToolTip="Distancia de la cara de la viga paralela a la primera fila de ladrillos (m). Desde ah&#237; se respeta el espaciamiento de las viguetas."/>
                                <TextBlock Text=" m" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="16,1,0,1">
                                <TextBlock Text="Ancho " VerticalAlignment="Center"/>
                                <TextBox x:Name="txt_vb" Width="36" TextChanged="form_changed"/>
                                <TextBlock Text=" m   @ " VerticalAlignment="Center"/>
                                <TextBox x:Name="txt_vs" Width="36" TextChanged="form_changed"/>
                                <TextBlock Text=" m" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Ladrillo de techo (tipos de la familia cargada):" Margin="0,6,0,1"/>
                            <ComboBox x:Name="cbo_brick" Margin="16,0,0,2" SelectionChanged="form_changed"
                                      ToolTip="Los tipos de ladrillo del proyecto, como en la paleta de propiedades. Para completar los extremos y los bordes se usan los tipos m&#225;s cortos o angostos de la misma familia y altura."/>
                            <CheckBox x:Name="chk_brick" Content="Colocarlos tambi&#233;n al generar el acero" Margin="16,2,0,2" Click="form_changed"/>
                            <CheckBox x:Name="chk_cut" Content="Cortar lo que sobresale (pieza a medida)" Margin="16,0,0,4" Click="form_changed"
                                      ToolTip="Ning&#250;n ladrillo sale de la losa ni entra en una viga: el que sobresale se coloca cortado, con un tipo de la misma familia a esa medida (se crea si no existe)."/>
                            <StackPanel Orientation="Horizontal" Margin="16,1,0,1">
                                <TextBlock Text="Ensanche " VerticalAlignment="Center"/>
                                <ComboBox x:Name="cbo_ens" Width="90" SelectionChanged="form_changed"/>
                                <TextBox x:Name="txt_ens" Width="36" Margin="4,0,0,0" TextChanged="form_changed"/>
                                <TextBlock Text=" m" VerticalAlignment="Center"/>
                            </StackPanel>
                        <Button x:Name="button_bricks" Content="COLOCAR SOLO LADRILLOS" Height="34" FontWeight="Bold" Margin="0,12,0,4"
                                Click="bricks_only_click"
                                ToolTip="Coloca (o vuelve a colocar) los ladrillos de techo de las losas seleccionadas, sin crear ni borrar acero."/>
                        <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap"
                                   Text="Los ladrillos que el plugin coloc&#243; antes en esas losas se reemplazan. La planta y los cortes muestran c&#243;mo quedan."/>
                    </StackPanel>
                </TabItem>
                </TabControl>
            </StackPanel>
            </ScrollViewer>

            <!-- Center: plan -->
            <DockPanel Grid.Column="1" Margin="0,0,6,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Ajustar" Width="60" Click="plan_fit_click"/>
                    <TextBlock FontWeight="Bold" VerticalAlignment="Center" Text="PLANTA   "/>
                    <ToggleButton x:Name="tool_dir" Content="&#8644; Elegir direcci&#243;n" Padding="6,0"
                                  ToolTip="Clic en una viga (o un borde de la losa): las viguetas y los ladrillos se colocan apoyados en ella (perpendiculares)."/>
                    <Button Content="Girar 90&#176;" Padding="6,0" Margin="4,0,0,0" Click="turn90_click"/>
                    <Button Content="Autom&#225;tica" Padding="6,0" Margin="4,0,0,0" Click="auto_dir_click"
                            ToolTip="Alineada al lado m&#225;s largo de la losa (sus vigas)."/>
                    <TextBlock Foreground="Gray" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"
                               Text="Arrastra los cortes 1-1 y 2-2. Rueda: zoom; bot&#243;n central: mover."/>
                </DockPanel>
                <Border BorderBrush="#FF9A9A9A" BorderThickness="1" Background="White" ClipToBounds="True">
                    <Canvas x:Name="canvas_plan" Background="White" SizeChanged="views_resized"
                            MouseWheel="plan_wheel" MouseDown="plan_down" MouseUp="plan_up" MouseMove="plan_move"/>
                </Border>
            </DockPanel>

            <!-- Right: the two cuts -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Ajustar" Width="60" Click="cut_fit_click" Tag="x"/>
                        <TextBlock x:Name="txt_cut_x" FontWeight="Bold" VerticalAlignment="Center" Text="CORTE 1-1"/>
                    </DockPanel>
                    <Border BorderBrush="#FF9A9A9A" BorderThickness="1" Background="White" ClipToBounds="True">
                        <Canvas x:Name="canvas_cut_x" Background="White" SizeChanged="views_resized" Tag="x"
                                MouseLeftButtonDown="cut_left" MouseWheel="cut_wheel" MouseDown="cut_down" MouseUp="cut_up" MouseMove="cut_move"/>
                    </Border>
                </DockPanel>
                <DockPanel Grid.Row="1">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Ajustar" Width="60" Click="cut_fit_click" Tag="y"/>
                        <TextBlock x:Name="txt_cut_y" FontWeight="Bold" VerticalAlignment="Center" Text="CORTE 2-2"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="Verde: inferior X. Azul: inferior Y. Rojo: superior X. Naranja: superior Y. Clic en una cota amarilla de un bast&#243;n para cambiar su largo desde la cara del apoyo (vale para todo ese apoyo)."/>
                    <Border BorderBrush="#FF9A9A9A" BorderThickness="1" Background="White" ClipToBounds="True">
                        <Canvas x:Name="canvas_cut_y" Background="White" SizeChanged="views_resized" Tag="y"
                                MouseLeftButtonDown="cut_left" MouseWheel="cut_wheel" MouseDown="cut_down" MouseUp="cut_up" MouseMove="cut_move"/>
                    </Border>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
