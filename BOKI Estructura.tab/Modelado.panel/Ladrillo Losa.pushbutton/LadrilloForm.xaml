<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ladrillo de techo en losa"
        Height="760" Width="1180" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" Background="#FFF3F5F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF2D8CF0"/>
            <Setter Property="Foreground" Value="#FF1F6FC5"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF16324F"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF16324F" Padding="16,8,16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="BOKI" Foreground="#FFFFB347" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="LADRILLO DE TECHO EN LOSA" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Foreground="#FFB9C9DA" FontSize="11"
                               Text="Losas aligeradas: coloca y borra los ladrillos sin tocar el acero. Las viguetas son las de Acero Losa."/>
                </StackPanel>
            </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,12,12">
            <Button Content="Borrar ladrillos" Width="150" Height="36" Margin="0,0,10,0" Click="delete_click"
                    ToolTip="Borra los ladrillos que el plugin coloc&#243; en las losas marcadas."/>
            <Button Content="Cerrar" Width="110" Height="36" Margin="0,0,10,0" Click="close_click" BorderBrush="#FFC9D3DE" Foreground="#FF16324F"/>
            <Button Content="COLOCAR LADRILLOS" Width="190" Height="36" FontWeight="Bold" Click="place_click"
                    ToolTip="Coloca (o vuelve a colocar) los ladrillos de las losas marcadas, como se ven en la planta."/>
        </StackPanel>
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="1. Losas" FontWeight="Bold" Margin="0,0,0,4"/>
                <Button Content="SELECCIONAR LOSAS" Height="32" Click="pick_click"/>
                <ListBox x:Name="list_slabs" Height="150" Margin="0,6,0,10" SelectionChanged="slab_changed"
                         ToolTip="La losa marcada se resalta en azul en la planta."/>
                <TextBlock Text="2. Ladrillo" FontWeight="Bold" Margin="0,0,0,4"/>
                <ComboBox x:Name="cbo_brick" SelectionChanged="form_changed"
                          ToolTip="Los tipos de ladrillo del proyecto. Define tambi&#233;n el espaciamiento de las viguetas (el mismo que usa Acero Losa)."/>
                <CheckBox x:Name="chk_cut" Content="Cortar lo que sobresale (pieza a medida)" Margin="0,6,0,0" Click="form_changed"/>
                <TextBlock Text="3. Direcci&#243;n de viguetas" FontWeight="Bold" Margin="0,12,0,4"/>
                <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                           Text="Cada pa&#241;o tiene su bot&#243;n &#8635; en la planta: clic = girar ese pa&#241;o 90&#176;; clic derecho = direcci&#243;n autom&#225;tica."/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Girar todas 90&#176;" Padding="8,2" Click="turn_all_click"/>
                    <Button Content="Todas autom&#225;tica" Padding="8,2" Margin="6,0,0,0" Click="auto_all_click"/>
                </StackPanel>
                <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"
                           Text="Costados: cada pa&#241;o tiene sus dos cotas rojas; clic en una para cambiar la distancia entre la viga y la primera o la &#250;ltima fila de ladrillos (0 = pegado a la viga)."/>
                <TextBlock x:Name="txt_status" TextWrapping="Wrap" Margin="0,12,0,0" FontWeight="Bold"/>
            </StackPanel>
            <DockPanel Grid.Column="1">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="Nivel: " VerticalAlignment="Center"/>
                        <ComboBox x:Name="cbo_level" Width="200" SelectionChanged="level_changed"
                                  ToolTip="Las losas de qu&#233; nivel se ven en la planta (todas se colocan)."/>
                    </StackPanel>
                    <TextBlock Text="PLANTA: todas las losas seleccionadas" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>
                <Border BorderBrush="#FF9A9A9A" BorderThickness="1" Background="White" ClipToBounds="True">
                    <Canvas x:Name="canvas_plan" Background="White" SizeChanged="plan_resized"/>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
