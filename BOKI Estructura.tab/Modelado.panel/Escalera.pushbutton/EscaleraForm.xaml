<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escalera de concreto" Height="760" Width="1280" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" Background="#FFF3F5F8">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFD0D7DF"/>
            <Setter Property="Foreground" Value="#FF16324F"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF2D8CF0"/>
            <Setter Property="Foreground" Value="#FF1F6FC5"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF16324F" Padding="16,8,16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="BOKI" Foreground="#FFFFB347" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="MODELADO &#183; ESCALERA DE CONCRETO" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Foreground="#FFB9C9DA" FontSize="11"
                               Text="Dibuja los tramos en la planta de Revit; cada tramo con su garganta recta y los descansos planos. La configuraci&#243;n sale del tipo de escalera."/>
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel Margin="12">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" x:Name="button_create" Content="CREAR ESCALERA" Width="240" Height="40" FontWeight="Bold"
                        Background="#FF2D8CF0" Foreground="White" BorderThickness="0" Click="create_click"/>
                <Button DockPanel.Dock="Right" Content="Cancelar" Width="110" Height="40" Margin="0,0,8,0" Click="cancel_click"/>
                <TextBlock x:Name="txt_status" VerticalAlignment="Center" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="800"/>
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" Margin="0,0,10,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="Tipo de escalera (de Revit)">
                            <StackPanel>
                                <ComboBox x:Name="cbo_type" SelectionChanged="type_changed"/>
                                <TextBlock x:Name="txt_type_info" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Niveles">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                <TextBlock Text="Base:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="cbo_base" VerticalAlignment="Center" SelectionChanged="config_changed"/>
                                <TextBlock Grid.Row="1" Text="Superior:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cbo_top" VerticalAlignment="Center" SelectionChanged="config_changed"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Dimensiones (del tipo; se pueden ajustar)">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/><RowDefinition Height="30"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Contrahuella m&#225;x. (cm):" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="txt_riser" VerticalAlignment="Center" TextChanged="config_changed"/>
                                <TextBlock Grid.Row="1" Text="Huella (cm):" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txt_tread" VerticalAlignment="Center" TextChanged="config_changed"/>
                                <TextBlock Grid.Row="2" Text="Ancho de tramo (m):" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txt_width" VerticalAlignment="Center" TextChanged="config_changed"/>
                                <TextBlock Grid.Row="3" Text="Garganta (cm):" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txt_waist" VerticalAlignment="Center" Foreground="#FF556270"/>
                                <TextBlock Grid.Row="4" Text="Espesor de descanso (cm):" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txt_landing" VerticalAlignment="Center" Foreground="#FF556270"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Boceto">
                            <StackPanel>
                                <Button x:Name="button_draw" Content="&#9998;  DIBUJAR EN PLANTA" Height="38" FontWeight="Bold"
                                        Background="#FF2D8CF0" Foreground="White" BorderThickness="0" Click="draw_click"/>
                                <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,6,0,0"
                                           Text="Revit abre la planta del nivel base: clic en el INICIO y el FIN de cada tramo, en el orden en que sube. Esc termina el boceto. Los descansos se crean solos entre tramos."/>
                                <Button Content="Borrar boceto" Height="26" Margin="0,6,0,0" Click="clear_click"/>
                                <TextBlock x:Name="txt_summary" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="1.4*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <GroupBox Header="PLANTA (boceto)">
                        <Canvas x:Name="canvas_plan" Background="White" ClipToBounds="True" SizeChanged="resized"/>
                    </GroupBox>
                    <GroupBox Grid.Row="1" Header="CORTE POR CADA TRAMO (garganta recta)">
                        <Canvas x:Name="canvas_cut" Background="White" ClipToBounds="True" SizeChanged="resized"/>
                    </GroupBox>
                </Grid>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
