<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Corregir Losas Inclinadas" Height="640" Width="1080" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" Background="#FFF3F5F8">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFD0D7DF"/>
            <Setter Property="Foreground" Value="#FF16324F"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF2D8CF0"/>
            <Setter Property="Foreground" Value="#FF1F6FC5"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF16324F" Padding="16,8,16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="BOKI" Foreground="#FFFFB347" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="CORREGIR LOSAS INCLINADAS" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Foreground="#FFB9C9DA" FontSize="11"
                               Text="Pendiente con flecha (espesor real) y ajuste a vigas cumbrera y de borde"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel Margin="12">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" x:Name="button_run" Content="CORREGIR" Width="230" Height="38" FontWeight="Bold"
                        Background="#FF2D8CF0" Foreground="White" BorderThickness="0" Click="run_click"/>
                <Button DockPanel.Dock="Right" Content="Cancelar" Width="120" Height="38" Margin="0,0,8,0" Click="cancel_click"/>
                <TextBlock x:Name="txt_status" VerticalAlignment="Center" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="600"/>
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                    <GroupBox DockPanel.Dock="Top" Header="&#191;Qu&#233; losas?">
                        <StackPanel TextElement.FontWeight="Normal">
                            <RadioButton x:Name="rb_all" GroupName="scope" IsChecked="True" Checked="scope_changed" Margin="0,4,0,0">
                                <TextBlock Text="Todas las inclinadas del modelo (autom&#225;tico)" FontWeight="Bold"/>
                            </RadioButton>
                            <TextBlock x:Name="txt_all" Foreground="#FF556270" FontSize="11" Margin="20,2,0,8"/>
                            <RadioButton x:Name="rb_pick" GroupName="scope" Checked="scope_changed">
                                <TextBlock Text="Seleccionar losas (clic en cada una)"/>
                            </RadioButton>
                            <DockPanel Margin="20,2,0,4">
                                <Button DockPanel.Dock="Right" x:Name="button_pick" Content="Seleccionar..." Padding="10,1" Click="pick_click"/>
                                <TextBlock x:Name="txt_pick" Foreground="#FF556270" FontSize="11" VerticalAlignment="Center"
                                           Text="Esc termina la selecci&#243;n"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox DockPanel.Dock="Bottom" Header="Corregir">
                        <StackPanel TextElement.FontWeight="Normal">
                            <CheckBox x:Name="chk_shape" IsChecked="True" Click="options_changed" Margin="0,4,0,4"
                                      Content="Forma: losa con flecha de pendiente (espesor real)"/>
                            <CheckBox x:Name="chk_ridge" IsChecked="True" Click="options_changed" Margin="0,0,0,4"
                                      Content="Ajustar a vigas cumbrera (hasta el eje, la viga corta)"/>
                            <CheckBox x:Name="chk_join" IsChecked="True" Click="options_changed"
                                      Content="Unir con vigas que la cortan"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Losas a corregir">
                        <ListBox x:Name="list_floors" SelectionChanged="floor_selected" FontWeight="Normal"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </GroupBox>
                </DockPanel>
                <GroupBox Grid.Column="1" x:Name="box_preview" Header="Vista previa">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" x:Name="txt_preview" Foreground="#FF1F9D55" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,2,0,4" Text="Corte por la cumbrera: as&#237; quedar&#225;"/>
                        <TextBlock DockPanel.Dock="Bottom" x:Name="txt_note" Foreground="#FF556270" FontSize="11" FontWeight="Normal"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <Canvas x:Name="canvas" Background="White" ClipToBounds="True" SizeChanged="resized"/>
                    </DockPanel>
                </GroupBox>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
