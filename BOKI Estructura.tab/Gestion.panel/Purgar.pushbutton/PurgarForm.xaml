<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purgar"
        Height="600" Width="560" MinWidth="460" MinHeight="460"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock FontSize="16" FontWeight="Bold" Text="Purgar lo que no se usa"/>
            <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="Marca lo que quieres borrar. Lo recomendado ya viene marcado. Está ordenado de lo más seguro a lo que conviene revisar."/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="txt_total" FontWeight="Bold" Foreground="#FF1F5FAE" Margin="0,0,0,4"/>
            <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Nunca se borra lo que empieza con BOKI. Si te arrepientes, Ctrl+Z lo deshace todo de una vez."/>
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" x:Name="button_run" Content="Purgar" Width="120" Height="34" FontWeight="Bold" Click="run_click"/>
                <Button DockPanel.Dock="Left" Content="Cerrar" Width="90" Height="34" Click="close_click"/>
            </DockPanel>
        </StackPanel>

        <Border BorderBrush="#FFD5D8DE" BorderThickness="1" Padding="10,6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="panel_groups"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
