<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acero - Cimentaci&#243;n"
        Height="880" Width="1560" MinWidth="1200" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" PreviewKeyDown="window_key">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" x:Name="button_run" Content="Generar acero..." Width="220" Height="40"
                    FontWeight="Bold" Click="run_click"
                    ToolTip="Guarda recubrimientos y acero en el tipo y genera las barras en los elementos seleccionados."/>
            <Button DockPanel.Dock="Right" Content="Abrir archivo..." Width="130" Height="40" Margin="0,0,8,0" Click="file_open_click"
                    ToolTip="Carga los recubrimientos guardados en un archivo."/>
            <Button DockPanel.Dock="Right" Content="Guardar en archivo..." Width="150" Height="40" Margin="0,0,8,0" Click="file_save_click"
                    ToolTip="Guarda los recubrimientos por cara en un archivo."/>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: elements + configuration -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="1. Selecciona la cimentaci&#243;n (zapata, cimiento corrido, losa de cimentaci&#243;n)."/>
                <Button DockPanel.Dock="Top" x:Name="button_pick" Content="SELECCIONAR CIMENTACI&#211;N" Height="34"
                        FontWeight="Bold" Click="pick_click"/>
                <TextBlock DockPanel.Dock="Top" x:Name="txt_picked" Foreground="Gray" HorizontalAlignment="Center"
                           Margin="0,4,0,6" Text="No hay elementos seleccionados."/>
                <ListBox DockPanel.Dock="Top" x:Name="list_elements" MaxHeight="160" SelectionChanged="element_selected"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                <Expander DockPanel.Dock="Top" Header="2. Recubrimientos por cara" Margin="0,8,0,0" IsExpanded="True">
                    <DockPanel Margin="6,4,6,4">
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,6"
                                   Text="Cada cara tiene su color y n&#250;mero en la vista 3D y en los alzados. Haz clic en una casilla para resaltar su cara."/>
                        <ScrollViewer DockPanel.Dock="Top" MaxHeight="190" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="panel_covers"/>
                        </ScrollViewer>
                    </DockPanel>
                </Expander>
                <Expander DockPanel.Dock="Top" Header="3. Configuraci&#243;n de acero" Margin="0,8,0,0" IsExpanded="True">
                    <StackPanel Margin="6,4,6,4">
                        <CheckBox x:Name="chk_bot" Content="Malla inferior (gancho hacia arriba)" FontWeight="Bold" Margin="0,4,0,2" IsChecked="True" Click="steel_changed"/>
                        <StackPanel Orientation="Horizontal" Margin="16,1,0,1" IsEnabled="{Binding IsChecked, ElementName=chk_bot}">
                            <TextBlock Text="Dir. X  &#216;" Width="58" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cbo_bot_dx" Width="62" SelectionChanged="steel_changed"/>
                            <TextBlock Text="  @ " VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_bot_sx" Width="46" TextChanged="steel_changed"/>
                            <TextBlock Text=" m" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,1,0,1" IsEnabled="{Binding IsChecked, ElementName=chk_bot}">
                            <TextBlock Text="Dir. Y  &#216;" Width="58" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cbo_bot_dy" Width="62" SelectionChanged="steel_changed"/>
                            <TextBlock Text="  @ " VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_bot_sy" Width="46" TextChanged="steel_changed"/>
                            <TextBlock Text=" m" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,1,0,1" IsEnabled="{Binding IsChecked, ElementName=chk_bot}">
                            <TextBlock Text="Gancho" Width="58" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_bot_hook" Width="46" TextChanged="steel_changed"
                                     ToolTip="Largo del gancho en cada extremo (m). 0 = recta."/>
                            <TextBlock Text=" m" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox x:Name="chk_top" Content="Malla superior (gancho hacia abajo)" FontWeight="Bold" Margin="0,4,0,2" IsChecked="False" Click="steel_changed"/>
                        <StackPanel Orientation="Horizontal" Margin="16,1,0,1" IsEnabled="{Binding IsChecked, ElementName=chk_top}">
                            <TextBlock Text="Dir. X  &#216;" Width="58" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cbo_top_dx" Width="62" SelectionChanged="steel_changed"/>
                            <TextBlock Text="  @ " VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_top_sx" Width="46" TextChanged="steel_changed"/>
                            <TextBlock Text=" m" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,1,0,1" IsEnabled="{Binding IsChecked, ElementName=chk_top}">
                            <TextBlock Text="Dir. Y  &#216;" Width="58" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cbo_top_dy" Width="62" SelectionChanged="steel_changed"/>
                            <TextBlock Text="  @ " VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_top_sy" Width="46" TextChanged="steel_changed"/>
                            <TextBlock Text=" m" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,1,0,1" IsEnabled="{Binding IsChecked, ElementName=chk_top}">
                            <TextBlock Text="Gancho" Width="58" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_top_hook" Width="46" TextChanged="steel_changed"
                                     ToolTip="Largo del gancho en cada extremo (m). 0 = recta."/>
                            <TextBlock Text=" m" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Boceto" FontWeight="Bold" Margin="0,8,0,2"/>
                        <StackPanel Orientation="Horizontal" Margin="16,1,0,1">
                            <ToggleButton x:Name="btn_sketch" Width="30" Height="26" Click="sketch_toggle"
                                          ToolTip="Dibujar barra por boceto: clic en cada punto en un alzado (se pega al recubrimiento), clic derecho para terminar. Esc cancela.">
                                <Canvas Width="16" Height="16">
                                    <Rectangle Width="16" Height="16" Stroke="#FF5B8BD0" StrokeThickness="1"/>
                                    <Line X1="3" Y1="13" X2="13" Y2="3" Stroke="#FF2E5FA8" StrokeThickness="2"/>
                                    <Rectangle Canvas.Left="1" Canvas.Top="11" Width="4" Height="4" Fill="#FF2E5FA8"/>
                                    <Rectangle Canvas.Left="11" Canvas.Top="1" Width="4" Height="4" Fill="#FF2E5FA8"/>
                                </Canvas>
                            </ToggleButton>
                            <TextBlock Text="  &#216;" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cbo_sketch_d" Width="62" Margin="2,0,0,0"/>
                            <TextBlock Text="  @ " VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_sketch_s" Width="46" Text="0.20"/>
                            <TextBlock Text=" m" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,2,0,1">
                            <TextBlock x:Name="txt_sketch_count" Text="0 barras dibujadas" Foreground="Gray" VerticalAlignment="Center" Width="140"/>
                            <Button Content="Borrar &#250;ltima" Width="90" Click="sketch_undo"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </DockPanel>

            <!-- Center: 3D -->
            <DockPanel Grid.Column="1" Margin="0,0,6,0">
                <TextBlock DockPanel.Dock="Top" x:Name="txt_title" FontWeight="Bold" Margin="0,0,0,4" Text="VISTA 3D"/>
                <Border BorderBrush="#FFBBBBBB" BorderThickness="1" Background="White">
                    <Viewport3D x:Name="view3d" ClipToBounds="True"
                                MouseWheel="view3d_wheel" MouseDown="view3d_mouse_down" MouseUp="view3d_mouse_up"
                                MouseMove="view3d_mouse_move"/>
                </Border>
            </DockPanel>

            <!-- Right: two elevations -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,4" Text="ALZADO FRONTAL (corte por el centro, mirando hacia +Y)"/>
                    <Border BorderBrush="#FFBBBBBB" BorderThickness="1">
                        <Canvas x:Name="canvas_front" Background="White" ClipToBounds="True" SizeChanged="views_resized"
                                MouseLeftButtonDown="front_left" MouseRightButtonDown="front_right" MouseMove="front_move"/>
                    </Border>
                </DockPanel>
                <DockPanel Grid.Row="1">
                    <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,4" Text="ALZADO LATERAL (corte por el centro, mirando hacia -X)"/>
                    <Border BorderBrush="#FFBBBBBB" BorderThickness="1">
                        <Canvas x:Name="canvas_side" Background="White" ClipToBounds="True" SizeChanged="views_resized"
                                MouseLeftButtonDown="side_left" MouseRightButtonDown="side_right" MouseMove="side_move"/>
                    </Border>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
