<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Metrado de acero estructural"
        Height="780" Width="1100" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" Background="#FFF3F5F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF2D8CF0"/>
            <Setter Property="Foreground" Value="#FF1F6FC5"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#FF16324F"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF16324F" Padding="16,8,16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="BOKI" Foreground="#FFFFB347" FontSize="20" FontWeight="Bold"/>
                <StackPanel>
                    <TextBlock Text="METRADO DE ACERO ESTRUCTURAL" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Foreground="#FFB9C9DA" FontSize="11"
                               Text="Todo lo generado por P&#243;rticos, Cerchas, Correas y Conexiones: cantidad, longitud, peso (volumen real x 7850 kg/m&#179;) y pintura."/>
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Exportar CSV (Excel)..." Width="190" Height="36" Margin="0,0,12,0" Click="export_click"/>
                <Button Content="Cerrar" Width="120" Height="36" Click="close_click" BorderBrush="#FFC9D3DE" Foreground="#FF16324F"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" x:Name="txt_total" FontWeight="Bold" FontSize="14" Margin="0,8,0,0"/>
            <Border Background="White" BorderBrush="#FFD0D7DF" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="pnl_rows" Margin="10"/>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
