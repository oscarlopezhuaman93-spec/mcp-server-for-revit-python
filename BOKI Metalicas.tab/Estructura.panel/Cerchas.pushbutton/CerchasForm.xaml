<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cerchas de tubo"
        Height="860" Width="1400" MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" Background="#FFF3F5F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF2D8CF0"/>
            <Setter Property="Foreground" Value="#FF1F6FC5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#FF16324F"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF16324F" Padding="16,8,16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="BOKI" Foreground="#FFFFB347" FontSize="20" FontWeight="Bold"/>
                <StackPanel>
                    <TextBlock Text="CERCHAS DE TUBO" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Foreground="#FFB9C9DA" FontSize="11"
                               Text="En arco, a dos aguas o rectas; secci&#243;n plana o espacial rectangular. Cordones, montantes, diagonales y travesa&#241;os de tubo rectangular."/>
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Left" Width="410" Margin="0,0,12,0">
                <TextBlock Text="1. Elige los ejes: los de las cerchas y los dos de apoyo." TextWrapping="Wrap"/>
                <Button Content="SELECCIONAR EJES" Height="32" Margin="0,6,0,2" FontWeight="Bold" Click="pick_click"/>
                <TextBlock x:Name="txt_axes" Foreground="#FF6B7B8C" TextWrapping="Wrap" Text="No hay ejes seleccionados." Margin="0,0,0,8"/>
                <Border Background="White" BorderBrush="#FFD0D7DF" BorderThickness="1" Padding="8,4"><TextBlock Text="2. Forma y secci&#243;n" FontWeight="Bold"/></Border>
                <Grid Margin="10,6,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                    <TextBlock Text="Forma"/><ComboBox Grid.Column="1" x:Name="cbo_shape" Height="24" Width="170" HorizontalAlignment="Left" SelectionChanged="changed"/>
                    <TextBlock Grid.Row="1" Text="Secci&#243;n"/><ComboBox Grid.Row="1" Grid.Column="1" x:Name="cbo_section" Height="24" Width="170" HorizontalAlignment="Left" SelectionChanged="changed"/>
                    <TextBlock Grid.Row="2" Text="Flecha del arco"/><StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="txt_rise" TextChanged="changed"/><TextBlock Text=" m"/></StackPanel>
                    <TextBlock Grid.Row="3" Text="Pendiente (dos aguas)"/><StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="txt_slope" TextChanged="changed"/><TextBlock Text=" %"/></StackPanel>
                    <TextBlock Grid.Row="4" Text="Peralte (eje a eje)"/><StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="txt_depth" TextChanged="changed"/><TextBlock Text=" m"/></StackPanel>
                    <TextBlock Grid.Row="5" Text="Ancho (espacial)"/><StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="txt_width" TextChanged="changed"/><TextBlock Text=" m"/></StackPanel>
                    <TextBlock Grid.Row="6" Text="Separaci&#243;n de montantes"/><StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="txt_panel" TextChanged="changed"/><TextBlock Text=" m (m&#225;x.)"/></StackPanel>
                    <TextBlock Grid.Row="7" Text="Apoyo sin columna"/><StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="txt_support" TextChanged="changed"/><TextBlock Text=" m sobre el nivel"/></StackPanel>
                </Grid>
                <Border Background="White" BorderBrush="#FFD0D7DF" BorderThickness="1" Padding="8,4"><TextBlock Text="3. Tubos rectangulares (Ht x b x t mm)" FontWeight="Bold"/></Border>
                <Grid Margin="10,6,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                    <TextBlock Text="Cordones"/><ComboBox Grid.Column="1" x:Name="cbo_chord" Height="24" Width="170" HorizontalAlignment="Left" SelectionChanged="changed"/>
                    <TextBlock Grid.Row="1" Text="Montantes y diagonales"/><ComboBox Grid.Row="1" Grid.Column="1" x:Name="cbo_web" Height="24" Width="170" HorizontalAlignment="Left" SelectionChanged="changed"/>
                    <TextBlock Grid.Row="2" Text="Travesa&#241;os (espacial)"/><ComboBox Grid.Row="2" Grid.Column="1" x:Name="cbo_cross" Height="24" Width="170" HorizontalAlignment="Left" SelectionChanged="changed"/>
                </Grid>
                <TextBlock x:Name="txt_error" Foreground="#FFC0392B" TextWrapping="Wrap"/>
                <TextBlock Foreground="#FF6B7B8C" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="El apoyo se toma de la cara superior de la columna que est&#233; en el cruce de ejes (concreto o acero). Est&#225;ndar por defecto: cercha de la cancha de Chumbivilcas."/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancelar" Width="120" Height="40" Margin="0,0,12,0" Click="cancel_click" BorderBrush="#FFC9D3DE" Foreground="#FF16324F"/>
                <Button Content="Generar cerchas..." Width="200" Height="40" FontWeight="Bold" Click="run_click"/>
            </StackPanel>
            <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#FFD0D7DF" BorderThickness="1" Padding="10" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="RESUMEN ANTES DE GENERAR" FontWeight="Bold"/>
                    <TextBlock x:Name="txt_summary" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#FFD0D7DF" BorderThickness="1">
                <Grid>
                    <TextBlock Text="CERCHA T&#205;PICA (ELEVACI&#211;N)" FontWeight="Bold" Margin="10,8" VerticalAlignment="Top"/>
                    <Canvas x:Name="cnv" ClipToBounds="True" SizeChanged="changed"/>
                </Grid>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
