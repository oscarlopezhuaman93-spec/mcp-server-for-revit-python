<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Correas y arriostres"
        Height="860" Width="1400" MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" Background="#FFF3F5F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF2D8CF0"/>
            <Setter Property="Foreground" Value="#FF1F6FC5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#FF16324F"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF16324F"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF16324F" Padding="16,8,16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="BOKI" Foreground="#FFFFB347" FontSize="20" FontWeight="Bold"/>
                <StackPanel>
                    <TextBlock Text="CORREAS Y ARRIOSTRES" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Foreground="#FFB9C9DA" FontSize="11"
                               Text="Sobre los p&#243;rticos ya generados: correas de techo y laterales, templadores y cruces de arriostre. E.090 / AISI S100."/>
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Left" Width="410" Margin="0,0,12,0">
                <TextBlock x:Name="txt_shed" Foreground="#FF6B7B8C" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Border Background="White" BorderBrush="#FFD0D7DF" BorderThickness="1" Padding="8,4"><TextBlock Text="1. Correas de techo" FontWeight="Bold"/></Border>
                <StackPanel Margin="10,4,0,8">
                    <CheckBox x:Name="chk_roof" Content="Colocar correas de techo" Click="changed"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                        <TextBlock Text="Perfil"/><ComboBox Grid.Column="1" x:Name="cbo_purlin" Height="24" Width="170" HorizontalAlignment="Left" SelectionChanged="changed"/>
                        <TextBlock Grid.Row="1" Text="Separaci&#243;n m&#225;xima"/><StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="txt_spacing" TextChanged="changed"/><TextBlock Text=" m (cobertura TR-4)"/></StackPanel>
                        <TextBlock Grid.Row="2" Text="Primera desde alero y cumbrera"/><StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="txt_first" TextChanged="changed"/><TextBlock Text=" m"/></StackPanel>
                    </Grid>
                </StackPanel>
                <Border Background="White" BorderBrush="#FFD0D7DF" BorderThickness="1" Padding="8,4"><TextBlock Text="2. Templadores (tirantes)" FontWeight="Bold"/></Border>
                <StackPanel Margin="10,4,0,8">
                    <CheckBox x:Name="chk_sag" Content="Templadores a los tercios del pa&#241;o" Click="changed"/>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Barra" Width="180"/><ComboBox x:Name="cbo_sag" Height="24" Width="170" SelectionChanged="changed"/></StackPanel>
                </StackPanel>
                <Border Background="White" BorderBrush="#FFD0D7DF" BorderThickness="1" Padding="8,4"><TextBlock Text="3. Correas laterales (largueros)" FontWeight="Bold"/></Border>
                <StackPanel Margin="10,4,0,8">
                    <CheckBox x:Name="chk_girts" Content="En los dos lados (paredes cerradas)" Click="changed"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                        <TextBlock Text="Perfil"/><ComboBox Grid.Column="1" x:Name="cbo_girt" Height="24" Width="170" HorizontalAlignment="Left" SelectionChanged="changed"/>
                        <TextBlock Grid.Row="1" Text="Separaci&#243;n en altura"/><StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="txt_girt_step" TextChanged="changed"/><TextBlock Text=" m"/></StackPanel>
                    </Grid>
                </StackPanel>
                <Border Background="White" BorderBrush="#FFD0D7DF" BorderThickness="1" Padding="8,4"><TextBlock Text="4. Arriostres (cruces de San Andr&#233;s)" FontWeight="Bold"/></Border>
                <StackPanel Margin="10,4,0,8">
                    <CheckBox x:Name="chk_brace_roof" Content="Techo, en los pa&#241;os extremos" Click="changed"/>
                    <CheckBox x:Name="chk_brace_walls" Content="Paredes, en los pa&#241;os extremos" Click="changed"/>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Barra" Width="180"/><ComboBox x:Name="cbo_brace" Height="24" Width="170" SelectionChanged="changed"/></StackPanel>
                </StackPanel>
                <TextBlock x:Name="txt_error" Foreground="#FFC0392B" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancelar" Width="120" Height="40" Margin="0,0,12,0" Click="cancel_click" BorderBrush="#FFC9D3DE" Foreground="#FF16324F"/>
                <Button x:Name="btn_run" Content="Generar..." Width="200" Height="40" FontWeight="Bold" Click="run_click"/>
            </StackPanel>
            <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#FFD0D7DF" BorderThickness="1" Padding="10" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="RESUMEN ANTES DE GENERAR" FontWeight="Bold"/>
                    <TextBlock x:Name="txt_summary" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#FFD0D7DF" BorderThickness="1">
                <Grid>
                    <TextBlock Text="PLANTA DE TECHO" FontWeight="Bold" Margin="10,8" VerticalAlignment="Top"/>
                    <Canvas x:Name="cnv" ClipToBounds="True" SizeChanged="changed"/>
                </Grid>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
