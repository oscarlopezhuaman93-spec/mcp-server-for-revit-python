<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conexiones met&#225;licas"
        Height="620" Width="900" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" Background="#FFF3F5F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF2D8CF0"/>
            <Setter Property="Foreground" Value="#FF1F6FC5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#FF16324F"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF16324F"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF16324F" Padding="16,8,16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="BOKI" Foreground="#FFFFB347" FontSize="20" FontWeight="Bold"/>
                <StackPanel>
                    <TextBlock Text="CONEXIONES MET&#193;LICAS" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Foreground="#FFB9C9DA" FontSize="11"
                               Text="Sobre los p&#243;rticos y cerchas BOKI: planchas de extremo, pernos A325, anclajes F1554 y apoyos articulados con pasador."/>
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel Margin="12">
            <TextBlock DockPanel.Dock="Top" x:Name="txt_found" Foreground="#FF6B7B8C" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancelar" Width="120" Height="40" Margin="0,0,12,0" Click="cancel_click" BorderBrush="#FFC9D3DE" Foreground="#FF16324F"/>
                <Button Content="Generar conexiones..." Width="200" Height="40" FontWeight="Bold" Click="run_click"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" x:Name="txt_error" Foreground="#FFC0392B" TextWrapping="Wrap"/>
            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,10,0">
                    <Border Background="White" BorderBrush="#FFD0D7DF" BorderThickness="1" Padding="8,4"><TextBlock Text="P&#243;rticos de alma llena" FontWeight="Bold"/></Border>
                    <StackPanel Margin="10,4,0,8">
                        <CheckBox x:Name="chk_eave" Content="Plancha de extremo en el alero (8 pernos)"/>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Espesor" Width="150"/><TextBox x:Name="txt_end_plate"/><TextBlock Text=" mm"/></StackPanel>
                        <CheckBox x:Name="chk_ridge" Content="Planchas de cumbrera (6 pernos)"/>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Espesor" Width="150"/><TextBox x:Name="txt_ridge_plate"/><TextBlock Text=" mm"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="Pernos A325" Width="150"/><TextBlock Text="3/4 pulg."/></StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <Border Background="White" BorderBrush="#FFD0D7DF" BorderThickness="1" Padding="8,4"><TextBlock Text="Cerchas y anclajes" FontWeight="Bold"/></Border>
                    <StackPanel Margin="10,4,0,8">
                        <CheckBox x:Name="chk_truss" Content="Apoyo articulado con pasador"/>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Cartelas" Width="150"/><TextBox x:Name="txt_gusset"/><TextBlock Text=" mm"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Pasador" Width="150"/><TextBox x:Name="txt_pin"/><TextBlock Text=" mm"/></StackPanel>
                        <CheckBox x:Name="chk_anchors" Content="Pernos de anclaje F1554 (4 por apoyo)"/>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Largo" Width="150"/><TextBox x:Name="txt_anchor_len"/><TextBlock Text=" m"/></StackPanel>
                    </StackPanel>
                </StackPanel>
            </UniformGrid>
        </DockPanel>
    </DockPanel>
</Window>
